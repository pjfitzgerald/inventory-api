<h1>Choose a new password</h1>
<p>Enter a new password for your Inventory account.</p>
<% if @error %><p class="error"><%= @error %></p><% end %>
<form method="post" action="/reset_password">
  <input type="hidden" name="token" value="<%= @token %>">
  <label for="password">New password</label>
  <input type="password" id="password" name="password"
         minlength="<%= User::PASSWORD_MIN_LENGTH %>" required autocomplete="new-password">
  <p class="hint">At least <%= User::PASSWORD_MIN_LENGTH %> characters. Avoid common
    passwords and anything based on your email address.</p>
  <button type="submit">Update password</button>
</form>
