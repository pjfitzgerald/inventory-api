#!/usr/bin/env ruby
# frozen_string_literal: true

# Inventory CLI — a single, dependency-free script (Ruby standard library only).
#
# Download and run directly, no `bundle install` / gem install required:
#   curl -o inventory https://raw.githubusercontent.com/pjfitzgerald/inventory-api/master/cli/inventory
#   chmod +x inventory
#   ./inventory auth login --email you@example.com --password <password>
#   ./inventory list
#
# Requires only a Ruby interpreter (2.7+). Talks to the public Inventory API
# over HTTPS; override the target with --url or INVENTORY_API_URL.

require 'net/http'
require 'uri'
require 'json'
require 'fileutils'
require 'optparse'
require 'digest'

DEFAULT_API_URL = 'https://inventory.optimisedthought.com/api/v1'

# Persists the auth token at ~/.config/inventory/token (mode 0600).
# The INVENTORY_API_TOKEN env var, when set, overrides the stored file.
module TokenStore
  module_function

  def path
    base = ENV['XDG_CONFIG_HOME']
    base = File.expand_path('~/.config') if base.to_s.empty?
    File.join(base, 'inventory', 'token')
  end

  def read
    env = ENV['INVENTORY_API_TOKEN']
    return env unless env.to_s.empty?
    return nil unless File.exist?(path)

    content = File.read(path).strip
    content.empty? ? nil : content
  end

  def write(token)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, token)
    File.chmod(0o600, path)
  end

  def clear
    File.delete(path) if File.exist?(path)
  end
end

# Caches the full item list so `find` can match locally instead of making the
# server do it. The API has one `ILIKE %term%` scope, which cannot match a
# multi-word phrase against separate words -- the case an agent hits most.
module ItemCache
  TTL_SECONDS = 600

  module_function

  def path_for(base_url, token)
    base = ENV['XDG_CACHE_HOME']
    base = File.expand_path('~/.cache') if base.to_s.empty?
    # Keyed by instance and account: the two prods hold different data, and
    # two accounts on one instance must not read each other's cache.
    key = Digest::SHA256.hexdigest("#{base_url}\x00#{token}")[0, 16]
    File.join(base, 'inventory', "items-#{key}.json")
  end

  def read(path, max_age: TTL_SECONDS)
    return nil unless File.exist?(path)
    return nil if Time.now - File.mtime(path) > max_age

    JSON.parse(File.read(path))
  rescue JSON::ParserError
    nil
  end

  def write(path, items)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, JSON.generate(items))
    File.chmod(0o600, path)
    items
  end

  # Called after every write, so a `find` straight after a `create` can't
  # serve a list that predates it.
  def invalidate(path)
    File.delete(path) if File.exist?(path)
  end
end

# Ranked local matching over the cached items. Deliberately forgiving: an
# agent turning "where's the blue down jacket" into a query should still land
# on "Down jacket (navy)".
module Search
  STOPWORDS = %w[a an the my our his her its their this that these those is are was were
                 in on at of for and or to with from where what which item items thing
                 things put stored store keep kept].freeze

  # field => weight. Everything searchable, but a name hit beats a notes hit.
  WEIGHTS = {
    'name' => 5.0, 'tags' => 3.0, 'category' => 3.0, 'current_location' => 2.0,
    'sublocation' => 2.0, 'intended_location' => 1.0, 'owner' => 1.0,
    'notes' => 1.0, 'location_notes' => 1.0, 'custom_fields' => 1.0
  }.freeze

  module_function

  def normalize(value)
    value.to_s.downcase.gsub(/[^a-z0-9]+/, ' ').strip
  end

  # Crude stemmer: enough to make "medals" find "medal" without a dependency.
  def stem(word)
    return word if word.length <= 3

    word.sub(/(ies)$/, 'y').sub(/(es|s)$/, '')
  end

  def terms(query)
    words = normalize(query).split(' ').reject { |w| STOPWORDS.include?(w) }
    words = normalize(query).split(' ') if words.empty? # a query of only stopwords
    words.uniq
  end

  def field_text(item, field)
    value = item[field]
    case value
    when Array then value.join(' ')
    when Hash then value.values.join(' ')
    else value.to_s
    end
  end

  # 0.0 (no match) .. 1.0 (exact word), scaled later by the field's weight.
  def term_quality(term, text)
    return 0.0 if text.empty?

    words = text.split(' ')
    stemmed = stem(term)
    return 1.0 if words.any? { |w| w == term || stem(w) == stemmed }
    return 0.8 if term.length >= 3 && words.any? { |w| w.start_with?(term) || term.start_with?(w) && w.length >= 4 }
    return 0.6 if text.include?(term)

    tolerance = term.length >= 6 ? 2 : 1
    return 0.45 if term.length >= 4 && words.any? { |w| (w.length - term.length).abs <= tolerance && levenshtein(w, term, tolerance) <= tolerance }

    0.0
  end

  # Bounded edit distance -- bails out as soon as the whole row exceeds max.
  def levenshtein(a, b, max)
    return (a.length - b.length).abs if a.empty? || b.empty?

    prev = (0..b.length).to_a
    a.each_char.with_index do |ca, i|
      row = [i + 1]
      b.each_char.with_index do |cb, j|
        row << [prev[j + 1] + 1, row[j] + 1, prev[j] + (ca == cb ? 0 : 1)].min
      end
      return max + 1 if row.min > max

      prev = row
    end
    prev.last
  end

  # Returns [results, strict] -- strict is false when no item matched every
  # term and the ranking fell back to "closest thing we have".
  def run(items, query, limit: 10)
    query_terms = terms(query)
    return [[], true] if query_terms.empty?

    scored = items.map do |item|
      texts = WEIGHTS.keys.to_h { |f| [f, normalize(field_text(item, f))] }
      per_term = query_terms.map do |term|
        WEIGHTS.map { |field, weight| weight * term_quality(term, texts[field]) }.max
      end
      [item, per_term.sum.round(3), per_term.all?(&:positive?)]
    end

    full = scored.select { |(_, score, all)| all && score.positive? }
    chosen = full.any? ? full : scored.select { |(_, score, _)| score.positive? }
    results = chosen.sort_by { |(item, score, _)| [-score, item['id'].to_i] }
                    .first(limit)
                    .map { |(item, score, _)| item.merge('score' => score) }

    [results, full.any?]
  end
end

class Client
  class Error < StandardError
    attr_reader :status, :body

    def initialize(message, status: nil, body: nil)
      super(message)
      @status = status
      @body = body
    end
  end

  attr_reader :base_url

  def initialize(base_url: ENV.fetch('INVENTORY_API_URL', DEFAULT_API_URL), token: TokenStore.read,
                 inventory_id: nil)
    @base_url = base_url.chomp('/')
    @token = token
    # Which inventory item commands act on. Nil means the account's personal
    # one, which is what the API assumes when none is named.
    @inventory_id = inventory_id
  end

  # --- items ---

  def list(query: nil)
    params = {}
    params['query'] = query if query
    request(Net::HTTP::Get, scoped('/items', params))
  end

  def show(id)
    request(Net::HTTP::Get, "/items/#{id}")
  end

  def create(attrs)
    request(Net::HTTP::Post, scoped('/items'), body: { item: attrs })
  end

  def update(id, attrs)
    request(Net::HTTP::Patch, "/items/#{id}", body: { item: attrs })
  end

  # Bins the item by default; `permanent: true` skips the recycle bin.
  def destroy(id, permanent: false)
    path = "/items/#{id}"
    path += '?permanent=true' if permanent
    request(Net::HTTP::Delete, path)
  end

  def trash
    request(Net::HTTP::Get, scoped('/items/trash'))
  end

  def restore(id)
    request(Net::HTTP::Post, "/items/#{id}/restore")
  end

  def purge
    request(Net::HTTP::Delete, scoped('/items/purge'))
  end

  # --- inventories ---

  def inventories
    request(Net::HTTP::Get, '/inventories')
  end

  # --- auth ---

  def signup(email:, password:, name: nil)
    request(Net::HTTP::Post, '/auth/signup', body: { email: email, password: password, name: name }.compact)
  end

  def login(email:, password:)
    request(Net::HTTP::Post, '/auth/login', body: { email: email, password: password })
  end

  def verify(token)
    request(Net::HTTP::Post, '/auth/verify', body: { token: token })
  end

  def request_password_reset(email)
    request(Net::HTTP::Post, '/auth/request_password_reset', body: { email: email })
  end

  def reset_password(token:, password:)
    request(Net::HTTP::Post, '/auth/reset_password', body: { token: token, password: password })
  end

  def me
    request(Net::HTTP::Get, '/auth/me')
  end

  private

  # Adds the selected inventory (and any other params) to a path.
  def scoped(path, params = {})
    params = params.merge('inventory_id' => @inventory_id) if @inventory_id
    return path if params.empty?

    "#{path}?#{URI.encode_www_form(params)}"
  end

  def request(method_class, path, body: nil)
    uri = URI("#{@base_url}#{path}")
    req = method_class.new(uri)
    req['Content-Type'] = 'application/json'
    req['Accept'] = 'application/json'
    req['Authorization'] = "Bearer #{@token}" if @token
    req.body = JSON.generate(body) if body

    res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == 'https') do |http|
      http.request(req)
    end

    parsed = res.body.to_s.empty? ? nil : (JSON.parse(res.body) rescue res.body)
    code = res.code.to_i

    return parsed if code >= 200 && code < 300

    raise Error.new(error_message(code, parsed), status: code, body: parsed)
  end

  def error_message(code, parsed)
    case code
    when 401
      parsed.is_a?(Hash) && parsed['error'] ? parsed['error'] : 'Not authenticated'
    when 404
      'Not found'
    when 422
      "Validation failed (#{validation_details(parsed)})"
    else
      summary = if parsed.is_a?(Hash)
                  parsed['error'] || parsed['message'] || parsed.keys.first(3).inspect
                else
                  parsed.to_s
                end
      "API #{code} #{summary}"
    end
  end

  def validation_details(parsed)
    return parsed.to_s unless parsed.is_a?(Hash)
    return Array(parsed['errors']).join('; ') if parsed['errors']

    parsed.map { |field, msgs| "#{field}: #{Array(msgs).join(', ')}" }.join('; ')
  end
end

module Formatters
  module_function

  def render(data, format:)
    case format
    when 'json' then puts JSON.pretty_generate(data)
    when 'table' then puts table(data)
    else raise ArgumentError, "unknown format: #{format}"
    end
  end

  def table(data)
    records = data.is_a?(Array) ? data : [data]
    return '(empty)' if records.empty?

    # Items get a fixed, useful column order; anything else (inventories)
    # falls back to whatever fields the record actually has.
    item_cols = %w[id name quantity category status tags current_location]
    cols = item_cols.all? { |c| records.first.key?(c) } ? item_cols : records.first.keys
    rows = records.map { |r| cols.map { |c| format_cell(r[c]) } }
    widths = cols.each_with_index.map { |c, i| ([c.length] + rows.map { |row| row[i].length }).max }

    header = cols.each_with_index.map { |c, i| c.ljust(widths[i]) }.join('  ')
    sep = widths.map { |w| '-' * w }.join('  ')
    body = rows.map { |row| row.each_with_index.map { |v, i| v.ljust(widths[i]) }.join('  ') }

    [header, sep, *body].join("\n")
  end

  def format_cell(value)
    case value
    when nil then ''
    when Array then value.join(',')
    when Hash then value.map { |k, v| "#{k}=#{v}" }.join(',')
    else value.to_s
    end
  end
end

# ---- CLI dispatch ----

USAGE = <<~USAGE
  Usage: inventory [--url=URL] [--format=json|table] [--inventory=ID] <command> [options]

  Auth commands:
    auth login --email=EMAIL [--password=PASSWORD]   Log in and store an auth token
    auth logout                                       Discard the stored auth token
    auth signup --email=EMAIL [--password=PASSWORD] [--name=NAME]
                                                       Create a new account
    auth verify --token=TOKEN                         Verify an email address
    auth request-reset --email=EMAIL                  Request a password-reset email
    auth reset-password --token=TOKEN --password=PASSWORD
                                                       Set a new password
    auth whoami                                       Show the current user

  Inventory commands:
    inventories                                       List inventories you can reach
                                                       (your personal one, plus any shared
                                                        with you) and your role in each

  Item commands:
    find WORDS... [--limit=N] [--refresh]             Ranked local search: matches
                                                       every word against every field,
                                                       tolerates typos and plurals.
                                                       Use this to turn a description
                                                       into an item id.
    list [--query=TEXT]                               List items
    show ID                                            Show a single item
    create --name=NAME [options]                       Create an item
    update ID [options]                                Update an item
    delete ID [--permanent]                            Move an item to the recycle bin
                                                        (--permanent deletes it outright)
    trash                                              List the recycle bin
    restore ID                                         Bring a binned item back
    purge                                              Empty the recycle bin

  Item options (create/update):
    --add-tags=a,b    --remove-tags=c     Edit the tag list in place
    --unset-field=KEY                     Drop one custom field
    --replace-fields                      Make --field replace custom_fields
                                           wholesale instead of merging
    --quantity=N  --category=C  --current-location=L  --sublocation=L
    --intended-location=L
    --weight=N  --owner=O  --notes=TEXT  --location-notes=TEXT
    --status=Keep|Sell|Discard
    --tags=tag1,tag2                Comma-separated; REPLACES the whole list
                                     (use --add-tags to append)
    --field=key:value               Custom field; repeatable. Merges into the
                                     existing custom fields on update.

  Global options:
    --format=json|table              Output format (default: json)
    --url=URL                        API base URL
                                      (default: $INVENTORY_API_URL or #{DEFAULT_API_URL})
    --inventory=ID                   Act on a shared inventory (see `inventories`);
                                      defaults to your personal one

  Sharing is managed in the web app: only members can read an inventory, and
  a viewer's writes are refused.

  Omit --password and you are prompted for it with echo off (or it is read
  from stdin when piped) -- safer than putting it in argv, and immune to the
  shell expanding a `!` or `$` inside it.

  `find` caches the item list under ~/.cache/inventory (10 minutes, dropped
  automatically after any create/update/delete).

  Auth: token is saved to ~/.config/inventory/token after login/signup/verify.
  Override per-invocation with INVENTORY_API_TOKEN.
USAGE

def die(message)
  warn message
  exit 1
end

# Reads a password without it ever appearing in argv -- so no shell history,
# no `ps` listing, and (the reason this exists) no chance of zsh mangling a
# `!` or `$` on the way in. Prompts with echo off on a terminal; otherwise
# takes one line from stdin, which is what makes `... | inventory auth login`
# and CI usage work.
def read_password(prompt = 'Password: ')
  if $stdin.tty?
    require 'io/console'
    value = $stdin.getpass(prompt)
    value.to_s.empty? ? die('No password entered.') : value
  else
    value = $stdin.gets
    die('No password on stdin.') if value.nil?
    value.chomp
  end
end

# Strips --format/--url out of argv wherever they appear (before or after
# the subcommand), so per-command parsers never have to know about them.
def extract_global_options!(argv, opts)
  i = 0
  while i < argv.length
    case argv[i]
    when /\A--format=(.+)\z/ then opts[:format] = Regexp.last_match(1); argv.delete_at(i)
    when '--format' then argv.delete_at(i); opts[:format] = argv.delete_at(i)
    when /\A--url=(.+)\z/ then opts[:url] = Regexp.last_match(1); argv.delete_at(i)
    when '--url' then argv.delete_at(i); opts[:url] = argv.delete_at(i)
    when /\A--inventory=(.+)\z/ then opts[:inventory_id] = Regexp.last_match(1); argv.delete_at(i)
    when '--inventory' then argv.delete_at(i); opts[:inventory_id] = argv.delete_at(i)
    else i += 1
    end
  end
end

# Returns [attrs, mods]. `attrs` is what goes straight into the PATCH/POST;
# `mods` describes the edits that need the item's current state first
# (tag add/remove, and merging rather than replacing custom fields).
def parse_item_options(argv)
  attrs = {}
  field = {}
  mods = { add_tags: [], remove_tags: [], unset_fields: [], replace_fields: false }
  parser = OptionParser.new do |o|
    o.on('--name=NAME') { |v| attrs['name'] = v }
    o.on('--quantity=N') { |v| attrs['quantity'] = v }
    o.on('--category=C') { |v| attrs['category'] = v }
    o.on('--current-location=L') { |v| attrs['current_location'] = v }
    o.on('--sublocation=L') { |v| attrs['sublocation'] = v }
    o.on('--intended-location=L') { |v| attrs['intended_location'] = v }
    o.on('--weight=N') { |v| attrs['weight'] = v }
    o.on('--owner=O') { |v| attrs['owner'] = v }
    o.on('--notes=TEXT') { |v| attrs['notes'] = v }
    o.on('--location-notes=TEXT') { |v| attrs['location_notes'] = v }
    o.on('--status=STATUS') { |v| attrs['status'] = v }
    o.on('--tags=TAGS') { |v| attrs['tags'] = v.split(',') }
    o.on('--add-tags=TAGS') { |v| mods[:add_tags].concat(v.split(',').map(&:strip).reject(&:empty?)) }
    o.on('--remove-tags=TAGS') { |v| mods[:remove_tags].concat(v.split(',').map(&:strip).reject(&:empty?)) }
    o.on('--field=KV') do |v|
      key, value = v.split(':', 2)
      field[key] = value
    end
    o.on('--unset-field=KEY') { |v| mods[:unset_fields] << v }
    o.on('--replace-fields') { mods[:replace_fields] = true }
  end
  parser.parse!(argv)
  attrs['custom_fields'] = field unless field.empty?
  [attrs, mods]
end

# Applies the edits that depend on the item's current state. Fetches the item
# only when one was actually asked for, so a plain field update stays a single
# request.
def apply_mods(client, id, attrs, mods)
  wants_tags = mods[:add_tags].any? || mods[:remove_tags].any?
  wants_fields = (attrs.key?('custom_fields') && !mods[:replace_fields]) || mods[:unset_fields].any?
  return attrs unless wants_tags || wants_fields

  current = client.show(id)

  if wants_tags
    die 'Pass either --tags or --add-tags/--remove-tags, not both.' if attrs.key?('tags')

    tags = Array(current['tags']).map(&:to_s)
    tags += mods[:add_tags]
    tags -= mods[:remove_tags]
    attrs['tags'] = tags.map(&:strip).reject(&:empty?).uniq
  end

  if wants_fields
    fields = (current['custom_fields'] || {}).merge(attrs['custom_fields'] || {})
    mods[:unset_fields].each { |key| fields.delete(key) }
    attrs['custom_fields'] = fields
  end

  attrs
end

def client_for(opts)
  args = {}
  args[:base_url] = opts[:url] if opts[:url]
  args[:inventory_id] = opts[:inventory_id] if opts[:inventory_id]
  Client.new(**args)
end

def cache_path_for(client)
  ItemCache.path_for(client.base_url, TokenStore.read)
end

def invalidate_cache!(client)
  ItemCache.invalidate(cache_path_for(client))
end

def require_auth!
  return if TokenStore.read

  die 'Not authenticated — run `inventory auth login` first.'
end

def run_auth(argv, opts)
  sub = argv.shift
  client = Client.new(**(opts[:url] ? { base_url: opts[:url] } : {}))

  case sub
  when 'login'
    email = password = nil
    OptionParser.new { |o| o.on('--email=E') { |v| email = v }; o.on('--password=P') { |v| password = v } }.parse!(argv)
    die 'auth login requires --email' unless email
    password ||= read_password
    result = client.login(email: email, password: password)
    TokenStore.write(result['token'])
    warn "Logged in as #{result.dig('user', 'email')}. Token saved to #{TokenStore.path}."
  when 'logout'
    TokenStore.clear
    warn 'Logged out.'
  when 'signup'
    email = password = name = nil
    OptionParser.new do |o|
      o.on('--email=E') { |v| email = v }
      o.on('--password=P') { |v| password = v }
      o.on('--name=N') { |v| name = v }
    end.parse!(argv)
    die 'auth signup requires --email' unless email
    password ||= read_password
    result = client.signup(email: email, password: password, name: name)
    warn(result['message'] || 'Account created.')
    if (token = result['verification_token'])
      warn "Verify with: inventory auth verify --token #{token}"
    end
    puts JSON.pretty_generate(result)
  when 'verify'
    token = nil
    OptionParser.new { |o| o.on('--token=T') { |v| token = v } }.parse!(argv)
    die 'auth verify requires --token' unless token
    result = client.verify(token)
    TokenStore.write(result['token']) if result['token']
    warn(result['message'] || 'Email verified.')
    warn "Logged in as #{result.dig('user', 'email')}."
  when 'request-reset'
    email = nil
    OptionParser.new { |o| o.on('--email=E') { |v| email = v } }.parse!(argv)
    die 'auth request-reset requires --email' unless email
    result = client.request_password_reset(email)
    warn(result['message'] || 'If that email has an account, a reset link has been sent.')
    if (token = result['reset_token'])
      warn "Reset with: inventory auth reset-password --token #{token} --password <new-password>"
    end
  when 'reset-password'
    token = password = nil
    OptionParser.new { |o| o.on('--token=T') { |v| token = v }; o.on('--password=P') { |v| password = v } }.parse!(argv)
    die 'auth reset-password requires --token' unless token
    password ||= read_password('New password: ')
    result = client.reset_password(token: token, password: password)
    TokenStore.write(result['token']) if result['token']
    warn(result['message'] || 'Password updated.')
    warn "Logged in as #{result.dig('user', 'email')}." if result.dig('user', 'email')
  when 'whoami'
    require_auth!
    puts JSON.pretty_generate(client.me['user'])
  else
    die "Unknown auth command: #{sub.inspect}\n\n#{USAGE}"
  end
end

opts = { format: 'json' }
argv = ARGV.dup

if argv.empty? || %w[-h --help help].include?(argv.first)
  puts USAGE
  exit(argv.empty? ? 1 : 0)
end

extract_global_options!(argv, opts)
command = argv.shift

begin
  case command
  when 'auth'
    run_auth(argv, opts)
  when 'inventories'
    require_auth!
    Formatters.render(client_for(opts).inventories, format: opts[:format])
  when 'list'
    require_auth!
    query = nil
    OptionParser.new { |o| o.on('--query=Q') { |v| query = v } }.parse!(argv)
    Formatters.render(client_for(opts).list(query: query), format: opts[:format])
  when 'find'
    require_auth!
    limit = 10
    refresh = false
    OptionParser.new do |o|
      o.on('--limit=N') { |v| limit = v.to_i }
      o.on('--refresh') { refresh = true }
    end.parse!(argv)
    query = argv.join(' ')
    die 'find requires something to search for' if query.strip.empty?

    client = client_for(opts)
    path = cache_path_for(client)
    items = refresh ? nil : ItemCache.read(path)
    if items.nil?
      items = ItemCache.write(path, client.list)
    else
      warn "(matching against #{items.length} cached items — `--refresh` to re-fetch)"
    end

    results, strict = Search.run(items, query, limit: limit)
    if results.empty?
      warn "No item matches #{query.inspect}."
    elsif !strict
      warn "No item matches every word of #{query.inspect} — showing the closest matches."
    end
    Formatters.render(results, format: opts[:format])
  when 'show'
    require_auth!
    id = argv.shift or die 'show requires an ID'
    Formatters.render(client_for(opts).show(id), format: opts[:format])
  when 'create'
    require_auth!
    attrs, mods = parse_item_options(argv)
    die 'create requires --name' unless attrs['name']
    # Nothing exists yet to add to, so these are just the initial values.
    attrs['tags'] = ((attrs['tags'] || []) + mods[:add_tags]).uniq if mods[:add_tags].any?
    client = client_for(opts)
    result = client.create(attrs)
    invalidate_cache!(client)
    Formatters.render(result, format: opts[:format])
  when 'update'
    require_auth!
    id = argv.shift or die 'update requires an ID'
    attrs, mods = parse_item_options(argv)
    client = client_for(opts)
    attrs = apply_mods(client, id, attrs, mods)
    die 'Nothing to update — pass at least one field.' if attrs.empty?
    result = client.update(id, attrs)
    invalidate_cache!(client)
    Formatters.render(result, format: opts[:format])
  when 'delete'
    require_auth!
    id = argv.shift or die 'delete requires an ID'
    permanent = false
    OptionParser.new { |o| o.on('--permanent') { permanent = true } }.parse!(argv)
    client = client_for(opts)
    client.destroy(id, permanent: permanent)
    invalidate_cache!(client)
    warn(permanent ? "Deleted item #{id}" : "Binned item #{id} — restore with `inventory restore #{id}`")
  when 'trash'
    require_auth!
    body = client_for(opts).trash
    warn "Binned items are purged after #{body['retention_days']} days."
    Formatters.render(body['items'], format: opts[:format])
  when 'restore'
    require_auth!
    id = argv.shift or die 'restore requires an ID'
    Formatters.render(client_for(opts).restore(id), format: opts[:format])
  when 'purge'
    require_auth!
    body = client_for(opts).purge
    warn "Purged #{body['purged']} item(s)"
  else
    die "Unknown command: #{command.inspect}\n\n#{USAGE}"
  end
rescue Client::Error => e
  die e.message
rescue Errno::ECONNREFUSED, SocketError => e
  url = ENV['INVENTORY_API_URL'] || opts[:url] || DEFAULT_API_URL
  die "Cannot reach API at #{url} (#{e.message})."
end
