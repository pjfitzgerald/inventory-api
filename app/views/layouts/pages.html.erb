<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inventory</title>
  <style>
    :root { --accent: #f97316; }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f4f4f5; color: #1f2937; padding: 1.5rem;
    }
    .card {
      background: #fff; border-radius: 12px; padding: 2.5rem;
      max-width: 26rem; width: 100%;
      box-shadow: 0 1px 3px rgba(0, 0, 0, .1), 0 10px 30px rgba(0, 0, 0, .06);
      border-top: 4px solid var(--accent);
    }
    h1 { margin: 0 0 .75rem; font-size: 1.35rem; }
    p { margin: .5rem 0; line-height: 1.5; color: #4b5563; }
    code {
      background: #f4f4f5; padding: .1rem .35rem; border-radius: 4px;
      font-size: .9em;
    }
    label {
      display: block; font-weight: 600; margin: 1.25rem 0 .35rem;
      font-size: .9rem; color: #1f2937;
    }
    input[type=password] {
      width: 100%; padding: .6rem .7rem; font-size: 1rem;
      border: 1px solid #d1d5db; border-radius: 8px;
    }
    button {
      margin-top: 1.25rem; width: 100%; padding: .65rem;
      background: var(--accent); color: #fff; border: 0; border-radius: 8px;
      font-size: 1rem; font-weight: 600; cursor: pointer;
    }
    button:hover { background: #ea670c; }
    .error { color: #b91c1c; font-size: .9rem; margin-top: .75rem; }
    .ok { color: #15803d; font-weight: 600; }
  </style>
</head>
<body>
  <main class="card">
    <%= yield %>
  </main>
</body>
</html>
